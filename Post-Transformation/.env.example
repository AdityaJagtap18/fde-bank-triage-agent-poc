# Per-learner Azure values for the deploy/ scripts. Copy to .env and edit.
# .env is git-ignored — deploy/00_env.sh sources it automatically and falls
# back to demo defaults for anything left unset.

# REQUIRED — your existing learner resource group (do NOT create a new one).
# List yours with: az group list -o table
RG=

# REQUIRED — globally-unique, lowercase Azure Container Registry name
# (becomes <ACR>.azurecr.io).
ACR=

# Optional — override only if your lab assigns different names.
# LOCATION=eastus
# ACA_ENV=cae-lab10
# APP=bank-triage-agent
# IMAGE_REPO=bank-triage-agent
# APP_INSIGHTS=appi-lab10
